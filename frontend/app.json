{
  "expo": {
    "name": "dianastuff",
    "slug": "frontend",
    "version": "1.0.15",
    "orientation": "portrait",
    "icon": "./assets/images/dianastuff-icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dianastuff.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pilih foto produk dan banner toko",
        "NSCameraUsageDescription": "Siaran live jualan pakai kamera",
        "NSMicrophoneUsageDescription": "Suara host saat siaran live",
        "NSLocationWhenInUseUsageDescription": "Tandai titik alamat pengiriman di peta"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/dianastuff-icon.png",
        "backgroundColor": "#F7F0FF"
      },
      "package": "com.dianastuff.app",
      "versionCode": 15,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dianastuff-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F0FF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#A855F7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih foto produk dan banner toko"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89749530-1cd9-42c6-a4c3-7dab67d7457f"
      }
    }
  }
}
