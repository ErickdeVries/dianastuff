{
  "expo": {
    "name": "dianastuff",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dianastuff.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pilih foto produk dan banner toko",
        "NSCameraUsageDescription": "Siaran live jualan pakai kamera",
        "NSMicrophoneUsageDescription": "Suara host saat siaran live"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.dianastuff.app",
      "permissions": ["READ_MEDIA_IMAGES", "CAMERA", "RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pilih foto produk dan banner toko"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
